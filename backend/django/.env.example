# Local development defaults. Use a private strong secret and DJANGO_DEBUG=false in production.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# PostgreSQL is the target database. Configure this URL for a local PostgreSQL instance.
# The values below are placeholders, not usable credentials:
# DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/SCMS_DB
# Leave DATABASE_URL unset only when intentionally using local SQLite checks.

# Comma-separated browser origins for the existing Vite frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Durable complaint attachments: private AWS S3 or an S3-compatible bucket (e.g. R2).
# Leave blank for local filesystem storage. Never commit real keys.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
# Optional for S3-compatible providers such as Cloudflare R2.
AWS_S3_ENDPOINT_URL=
