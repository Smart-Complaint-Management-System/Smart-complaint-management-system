# Copy to .env and replace the Django secret before deployment.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is enabled when DATABASE_URL is set. Example:
# DATABASE_URL=postgres://scms:password@localhost:5432/scms
# Without DATABASE_URL, local development uses SQLite.

# Comma-separated browser origins for the existing Vite frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
